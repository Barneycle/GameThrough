# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/IntegrativeProject?retryWrites=true&w=majority
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Comma-separated frontend URLs. Leave empty to allow any origin.
# Local: http://localhost:3001
# Vercel: https://your-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:3001
